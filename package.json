{
  "name": "ai-usage-cost",
  "version": "1.3.0",
  "private": false,
  "description": "Claude Code usage & cost dashboard: one offline HTML file, spend by day, project and session, $/hour, history beyond 30 days",
  "license": "MIT",
  "author": "Oleksandr Krasnokutskyi <okrasn.dev@gmail.com>",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "usage",
    "cost",
    "token-usage",
    "dashboard",
    "cost-tracking",
    "usage-tracking",
    "html-report",
    "analytics",
    "ccusage",
    "llm-cost",
    "ai-cost",
    "tokens",
    "claude-code-skill",
    "privacy",
    "local-first",
    "cli",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okrasn/ai-usage-cost.git"
  },
  "bugs": {
    "url": "https://github.com/okrasn/ai-usage-cost/issues"
  },
  "homepage": "https://github.com/okrasn/ai-usage-cost#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bin": {
    "ai-usage-cost": "bin/install.mjs"
  },
  "scripts": {
    "setup": "node ./bin/install.mjs",
    "copy-dashboard": "node ./bin/install.mjs --dashboard",
    "copy-skill": "node ./bin/install.mjs --skill",
    "copy-command": "node ./bin/install.mjs --skill",
    "build": "node ./build.mjs",
    "start": "npm run build",
    "test": "node --test",
    "prices:update": "node ./scripts/update-prices.mjs",
    "verify:ccusage": "node ./scripts/verify-ccusage.mjs"
  },
  "files": [
    "bin/install.mjs",
    "build.mjs",
    "lib",
    "vendor",
    "template.html",
    "skill/SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
