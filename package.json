{
  "name": "ccusage-ui-dashboard",
  "version": "1.3.0",
  "private": false,
  "description": "Local visual dashboard for Claude Code usage analytics (cost & tokens by day/week/month/model). Reads local Claude logs via ccusage package; renders a self-contained HTML dashboard with Chart.js — no server, no telemetry. Ships with a /<prefix>-usage slash command for Claude Code.",
  "license": "MIT",
  "author": "Oleksandr Krasnokutskyi <okrasn.dev@gmail.com>",
  "keywords": [
    "claude",
    "claude-code",
    "ccusage",
    "dashboard",
    "analytics",
    "cost-tracking",
    "slash-command"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okrasn/ccusage-ui-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/okrasn/ccusage-ui-dashboard/issues"
  },
  "homepage": "https://github.com/okrasn/ccusage-ui-dashboard#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bin": {
    "ccusage-ui-dashboard": "bin/install.mjs"
  },
  "scripts": {
    "setup": "node ./bin/install.mjs",
    "copy-dashboard": "node ./bin/install.mjs --dashboard",
    "copy-skill": "node ./bin/install.mjs --skill",
    "copy-command": "node ./bin/install.mjs --skill",
    "build": "node ./build.mjs",
    "start": "npm run build",
    "test": "node --test",
    "prices:update": "node ./scripts/update-prices.mjs",
    "verify:ccusage": "node ./scripts/verify-ccusage.mjs"
  },
  "files": [
    "bin/install.mjs",
    "build.mjs",
    "lib",
    "vendor",
    "template.html",
    "skill/SKILL.md",
    "README.md",
    "LICENSE",
    "example.jpg"
  ]
}
